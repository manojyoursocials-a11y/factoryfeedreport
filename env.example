# Password for the /admin dashboard. Set your own value in Vercel's
# Environment Variables settings — never commit your real password to git.
ADMIN_PASSWORD=change-this-password

# Random long string used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string

# Added automatically when you connect an Upstash Redis database
# through the Vercel Marketplace (Storage tab in your Vercel project).
# You do not need to set these by hand if you use the Marketplace flow.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
